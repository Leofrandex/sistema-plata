# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# obsidian
.obsidian/

# credenciales en texto plano (NUNCA versionar)
vault/secrets/

# claude code local config
.claude/

# salidas derivadas de scripts/extract-kilos-historicos.py — se regeneran desde
# los Excel de docs/fuentes/ y no aportan nada versionadas
/scripts/out/

# temporales del CLI de Supabase (guarda la versión descargada, no es del proyecto)
/supabase/.temp/

# next-pwa generated artifacts (legado)
**/public/sw.js
**/public/sw.js.map
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/fallback-*.js

# demo report artifacts (contienen fotos reales del piloto) + fuentes sueltas de logos
/demo-report-page*.png
/logo-black.png
/BrW1JbIM.jpg

# credenciales en texto plano (NUNCA versionar)
/vault/credenciales/

# respaldos de datos del piloto (dumps JSON pre-reset) — NUNCA versionar
/backups/

# grafo de código (graphify) — derivado del código, se regenera en ~40s sin costo
# con `python -m graphify update .`. graph.json pesa ~2 MB y cambia en cada commit.
# Sin anclar a la raíz: graphify deja cache en el workspace que se le pase como path.
graphify-out/

# Android release signing — NUNCA versionar el keystore ni las credenciales reales
*.keystore
*.jks
/app/android/keystore.properties
