{
  "name": "hospiwaste-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "hub",
    "app"
  ],
  "scripts": {
    "build": "npm run build:hub && npm run build:app",
    "build:hub": "npm run build -w hub",
    "build:app": "npm run build -w app",
    "dev:hub": "npm run dev -w hub",
    "dev:app": "npm run dev -w app",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "test:ui": "npm run test:ui -w shared --if-present"
  },
  "devDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "shadcn": "^4.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
